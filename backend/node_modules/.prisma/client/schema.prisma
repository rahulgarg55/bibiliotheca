datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  avatarColor  String   @default("#8b5cf6")
  status       String   @default("active") // 'active' | 'suspended'
  role         String   @default("user")   // 'user' | 'admin'
  goal         Int      @default(3)
  goalProgress Int      @default(0)
  fines        Float    @default(0.0)
  loans        Loan[]
  holds        Hold[]
}

model Book {
  id           String   @id @default(uuid())
  title        String
  author       String
  isbn         String   @unique
  genre        String
  year         Int
  rating       Float    @default(0.0)
  ratingsCount Int      @default(0)
  copies       Int      @default(1)
  available    Int      @default(1)
  pages        Int
  summary      String
  coverColor   String
  excerpt      String
  loans        Loan[]
  holds        Hold[]
  reviews      Review[]
}

model Loan {
  id         String    @id @default(uuid())
  userId     String
  bookId     String
  borrowDate DateTime  @default(now())
  dueDate    DateTime
  returnDate DateTime?
  status     String    @default("active") // 'active' | 'returned' | 'overdue'
  fineAmount Float     @default(0.0)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  book       Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

model Hold {
  id       String   @id @default(uuid())
  bookId   String
  userId   String
  holdDate DateTime @default(now())
  status   String   @default("pending") // 'pending' | 'fulfilled'
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book     Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

model Review {
  id      String @id @default(uuid())
  bookId  String
  user    String
  rating  Int
  comment String
  date    String
  book    Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

model SystemLog {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())
  type      String   // 'checkout' | 'return' | 'system' | 'admin' | 'fine'
  message   String
}
